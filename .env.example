# --- LLM provider ---
# Groq, free-tier API key from https://console.groq.com/keys
GROQ_API_KEY=
# Groq's free-tier rate limits are PER MODEL (see
# console.groq.com/docs/rate-limits) — 30 RPM / 8K TPM each, as of writing,
# for openai/gpt-oss-120b, openai/gpt-oss-20b and qwen/qwen3.8-27b. Listing
# several here pools them: each request goes to whichever model has
# headroom right now, and a real 429 on one falls over to the next instead
# of surfacing an error. Leave unset to use the built-in default pool
# (those same three models, best quality first).
GROQ_MODEL_POOL=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# A single model instead of a pool — set this (and leave GROQ_MODEL_POOL
# unset) to pin one model with no fallback. GROQ_MODEL_POOL wins if both
# are set.
GROQ_MODEL=
# Tokens-per-minute and requests-per-minute budgets to self-limit against,
# applied per model in the pool — check
# https://console.groq.com/docs/rate-limits before relying on these
# defaults, they change per model/account.
GROQ_TPM_BUDGET=6000
GROQ_RPM_BUDGET=28

# --- Database ---
# MongoDB connection string (Atlas free tier or local)
MONGODB_URI=mongodb://localhost:27017/interview-prep-kit

# --- Auth / sessions ---
# Random 32+ byte secret used to sign session cookies/JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- API server ---
PORT=4000
NODE_ENV=development
# Comma-separated origins allowed to call the API (the deployed web app URL, plus localhost in dev)
CORS_ORIGIN=http://localhost:3000

# --- Web app ---
# Base URL the Next.js app uses to call the API
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Retrieval / crawling ---
# Max pages fetched per company during a crawl, and per-request timeout (ms)
CRAWL_MAX_PAGES=15
CRAWL_TIMEOUT_MS=8000
# Set to "true" to allow fetching localhost/private addresses (only ever set for
# the batch evaluate command against local fixture sites — never in production)
ALLOW_PRIVATE_HOSTS=false
